# Production secrets for docker/docker-compose.prod.yml. Copy to docker/.env (gitignored) and fill in.
DB_USER=story
DB_NAME=story
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Git support for stories (docs/Server.md#git). The key encrypts the access tokens stored in the database:
# 32 random bytes in base64, `openssl rand -base64 32`. Empty: git is unavailable. Keep it with the database
# backup: a lost or changed key means every story's token has to be entered again.
GIT_TOKEN_KEY=
# Optional, comma-separated host names a story's git remote may point at (e.g. github.com,gitlab.com). Empty: any HTTPS host.
GIT_ALLOWED_HOSTS=

# Password reset mails (docs/Server.md#password-reset): an SMTP URL, e.g. smtps://user:password@smtp.example.com:465.
# Empty: the server only logs the mails, with their links.
SMTP_URL=
