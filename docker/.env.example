# Production secrets for docker/docker-compose.prod.yml. Copy to docker/.env (gitignored) and fill in.
DB_USER=story
DB_NAME=story
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Git support for stories (docs/Server.md#git). The key encrypts the access tokens stored in the database:
# 32 random bytes in base64, `openssl rand -base64 32`. Empty: git is unavailable. Keep it with the database
# backup: a lost or changed key means every story's token has to be entered again.
GIT_TOKEN_KEY=
# Optional, comma-separated host names a story's git remote may point at (e.g. github.com,gitlab.com). Empty: any HTTPS host.
GIT_ALLOWED_HOSTS=

# Password reset mails (docs/Server.md#password-reset): an SMTP URL, e.g. smtps://user:password@smtp.example.com:465.
# Empty: the server only logs the mails, with their links.
SMTP_URL=

# AI agent (docker-compose.prod.yml header, docs/Server.md#ai-agent). The group id of the host's docker socket,
# `stat -c %g /var/run/docker.sock`: the ai-launcher service joins it. Required by the production stack (dev: 0 if unset).
# The two secrets are files, not variables: docker/secrets/ai_token (the Anthropic API key, `sk-ant-api…`; empty =
# AI unavailable) and docker/secrets/ai_launcher_key (`openssl rand -hex 32 > docker/secrets/ai_launcher_key`).
# Both must exist and be readable by uid 1000. docker/secrets/gemini_token is the Gemini API key for image
# generation (paid tier, so Google doesn't train on story content; empty or missing = no image generation).
DOCKER_GID=
# Models, the budget cap and the image limits are not variables either: docker/secrets/ai_agents.json (copy
# ai_agents.example.json; empty = the defaults), read by the server and the launcher at start. After a change:
# `docker compose -f docker/docker-compose.prod.yml restart ai-launcher server`. AI_MODELS / AI_MAX_BUDGET_USD are gone.

# Dev only (docker-compose.yml): absolute host paths, because the launcher's `docker run` mounts are resolved on
# the host. AI_STORIES_HOST_DIR is the repo's `stories/` folder, AI_REPO_HOST_DIR the repo itself. Unset: AI is
# unavailable in dev. On Docker Desktop, AI_SANDBOX_DRIVER=docker-sandbox uses Docker Sandboxes.
AI_STORIES_HOST_DIR=
AI_REPO_HOST_DIR=
AI_SANDBOX_DRIVER=
