FROM node:22.14.0

ARG UNAME=node
ARG UGROUP=node

RUN apt-get update && apt-get install -y jq && rm -rf /var/lib/apt/lists/*
RUN npm install -g typescript-language-server typescript

# playwright
RUN npm install -g @playwright/cli @playwright/test
RUN playwright-cli install-browser --with-deps chrome
RUN su -s /bin/bash "$UNAME" -c "playwright install ffmpeg"

RUN corepack enable

# The password reset mails' sender, hardcoded for now (plans/rosti-release.md); without SMTP_URL they are only logged
ENV MAIL_FROM=info@story.cz
