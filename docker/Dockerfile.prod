# Production image (multiple stories, phase 11), used by `docker-compose.prod.yml`. Three targets:
#
#   app    the repo with its dependencies installed: runs the Visualizer server (`tsx src/index.ts`)
#          and, until the per-story engine build lands (plan D7), the SingleEngine Vite dev server
#   web    `app` plus the static builds of the landing page (base `/`) and the Visualizer client
#          (base `/visualizer/`); only a build stage, nothing runs it
#   proxy  Caddy with `docker/Caddyfile` and the two builds from `web`: the one public origin
#
# The cross-app links are baked into the static builds as paths, not origins (`/`, `/visualizer`,
# `/play`), so the images do not depend on the domain; `SITE_ADDRESS` is read at run time.

FROM node:22.14.0 AS app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node . .
RUN yarn install --immutable
# The seed for an empty `stories` volume (`docker/prod-entrypoint.sh`). `/app/stories` itself is
# shadowed by the volume at run time.
RUN mkdir -p /app/.seed && cp -a stories/example /app/.seed/example && chmod +x docker/prod-entrypoint.sh
ENTRYPOINT ["/app/docker/prod-entrypoint.sh"]

FROM app AS web
RUN LANDING_BASE=/ VITE_VISUALIZER_URL=/visualizer VITE_ENGINE_URL=/play \
        yarn workspace @story/visualizer-landing-page build \
    && VISUALIZER_BASE=/visualizer/ VITE_LANDING_URL=/ \
        yarn workspace @story/visualizer-client build

FROM caddy:2 AS proxy
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /app/Visualizer/landing-page/dist /srv/landing
COPY --from=web /app/Visualizer/client/dist /srv/visualizer
