# Production image (multiple stories, phase 11), used by `docker/docker-compose.prod.yml`. Four targets:
#
#   app       the repo with its dependencies installed: runs the server (`server/`, through the swc loader);
#             also holds the standalone SinglePlayer build (base `./`) that the server zips for "Export for web"
#   launcher  `app` plus the docker CLI: the AI launcher (`server/aiLauncher/`), the only service with the
#             docker socket. The server image gets no docker CLI
#   web       `app` plus the static builds of the landing page (base `/`), the Visualizer client
#             (base `/visualizer/`) and SinglePlayer (base `/play/`); only a build stage, nothing runs it
#   proxy     Caddy with `docker/Caddyfile` and the three builds from `web`: the one public origin
#
# The cross-app links are baked into the static builds as paths, not origins (`/`, `/visualizer`,
# `/play`), so the images do not depend on the domain; `SITE_ADDRESS` is read at run time.

FROM node:22.14.0 AS app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node . .
RUN yarn install --immutable
# `index.html` + `player/` with no URL baked in: the web export runs on any static host
RUN yarn workspace @story/single-player build:standalone
ENV SINGLE_PLAYER_STANDALONE_DIR=/app/clients/SinglePlayer/dist-standalone
# The password reset mails' sender, hardcoded for now: replace it before going live (plans/rosti-release.md)
ENV MAIL_FROM=info@story.cz
# The example's content for an empty `stories` volume (`docker/prod-entrypoint.sh`; its metadata is
# `server/seed/example.story.json`). `/app/stories` itself is shadowed by the volume at run time.
RUN mkdir -p /app/.seed && cp -a stories/example /app/.seed/ && chmod +x docker/prod-entrypoint.sh
# The mount point of the `story-ai-sessions` volume: created here so a new volume is owned by `node`, the uid
# the agents run as (the server creates one folder per story in it)
RUN mkdir -p /app/ai-sessions
ENTRYPOINT ["/app/docker/prod-entrypoint.sh"]

FROM app AS launcher
USER root
RUN sh docker/install-docker-cli.sh
USER node
WORKDIR /app/server
ENTRYPOINT []
CMD ["node", "--import", "@swc-node/register/esm-register", "aiLauncher/main.ts"]

FROM app AS web
RUN LANDING_BASE=/ VITE_VISUALIZER_URL=/visualizer VITE_ENGINE_URL=/play \
        yarn workspace @story/visualizer-landing-page build \
    && VISUALIZER_BASE=/visualizer/ VITE_LANDING_URL=/ VITE_PLAYER_URL=/play \
        yarn workspace @story/visualizer-client build \
    && PLAYER_BASE=/play/ VITE_LANDING_URL=/ \
        yarn workspace @story/single-player build

FROM caddy:2 AS proxy
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /app/clients/LandingPage/dist /srv/landing
COPY --from=web /app/clients/Visualizer/dist /srv/visualizer
COPY --from=web /app/clients/SinglePlayer/dist /srv/play
