{
    "name": "story-root",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "types",
        "data",
        "shared",
        "ui",
        "core",
        "SingleEngine",
        "Visualizer/*",
        "MultiEngine/*"
    ],
    "scripts": {
        "start": "vite",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "build": "yarn typecheck && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "pretty": "prettier . --write",
        "pretty:check": "prettier . --check"
    },
    "dependencies": {
        "@emotion/react": "^11.13.3",
        "@emotion/styled": "^11.13.0",
        "@mui/icons-material": "^6.1.0",
        "@mui/material": "^6.1.0",
        "d3": "^7.9.0",
        "jlouvain": "^2.0.0",
        "mobx": "^6.13.2",
        "mobx-react-lite": "^4.0.7",
        "ngraph.forcelayout": "^3.3.1",
        "ngraph.graph": "^20.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "vite-tsconfig-paths": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@types/d3": "^7.4.3",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^24.3.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.2",
        "eslint": "^9.9.0",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.9",
        "globals": "^15.9.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.3.3",
        "tsx": "^4.20.5",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.0.1",
        "vite": "^5.4.9"
    },
    "resolutions": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "packageManager": "yarn@4.5.0"
}
