{
    "name": "@story/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "comment:scripts": "Source-only: the swc loader transpiles with decorator metadata, which tsx/esbuild cannot emit (plan R1). The TypeORM CLI runs through the same loader.",
    "scripts": {
        "dev": "node --import @swc-node/register/esm-register scripts/dev.ts",
        "start": "node --import @swc-node/register/esm-register src/main.ts",
        "orm": "NODE_OPTIONS=\"--import @swc-node/register/esm-register\" typeorm",
        "migration:create": "yarn orm migration:create",
        "migration:generate": "yarn orm migration:generate -d src/database/dataSource.ts",
        "migration:run": "yarn orm migration:run -d src/database/dataSource.ts",
        "migration:revert": "yarn orm migration:revert -d src/database/dataSource.ts",
        "migration:show": "yarn orm migration:show -d src/database/dataSource.ts",
        "stories:import-files": "node --import @swc-node/register/esm-register scripts/importStoryFiles.ts"
    },
    "dependencies": {
        "@nestjs/common": "^12.1.3",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.3",
        "@nestjs/platform-express": "^12.1.3",
        "@nestjs/typeorm": "^12.0.2",
        "@story/protocol": "workspace:^",
        "@story/shared": "workspace:^",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.18",
        "chokidar": "^4.0.3",
        "fflate": "^0.8.3",
        "mysql2": "^3.24.6",
        "prettier": "^3.3.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ts-morph": "^24.0.0",
        "typeorm": "^1.1.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@nestjs/testing": "^12.1.3",
        "@types/node": "^24.3.0",
        "typescript": "^5.6.3",
        "unplugin-swc": "^2.0.0"
    }
}
