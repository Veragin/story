{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        /* The template's own view of the world, so it type-checks where it lies
           (`scripts/typecheck-stories.mjs` checks it with the stories). It is not copied: a new
           story gets a `tsconfig.json` of the same shape written for its own folder
           (`src/stories/storyTsconfig.ts`), because the engine paths are relative. */
        "paths": {
            "@story/types": ["types/index.ts"],
            "@story/data": ["data/index.ts"],
            "@story/data/*": ["data/*"],
            "@story/core": ["../../clients/shared/core/src/index.ts"],
            "@story/shared": ["../../clients/shared/utils/src/index.ts"],
            "@story/ui": ["../../clients/shared/ui/src/index.ts"],
            "react": ["../../node_modules/@types/react/index.d.ts"],
            "react/*": ["../../node_modules/@types/react/*"],
            "@mui/material": ["../../node_modules/@mui/material/index.d.ts"],
            "@mui/icons-material": [
                "../../node_modules/@mui/icons-material/index.d.ts"
            ],
            "@mui/icons-material/*": [
                "../../node_modules/@mui/icons-material/*"
            ]
        }
    },
    "include": ["data", "types"],
    "exclude": ["node_modules"]
}
