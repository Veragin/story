{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            /* Workspace packages — source-only, mapped straight at the .ts entry (§7).
               Targets are placeholder barrels until Phases 3–6 fill them. */
            "@story/types": ["types/index.ts"],
            "@story/shared": ["shared/src/index.ts"],
            "@story/ui": ["ui/src/index.ts"],
            "@story/core": ["core/src/index.ts"],
            "@story/data": ["data/index.ts"],
            "@story/data/*": ["data/*"],

            /* Legacy `baseUrl: src` style imports of the not-yet-moved app.
               Each of these disappears as its phase lands. */
            "code/Engine/*": ["src/code/Engine/*"],
            "code/Visualizer/*": ["src/code/Visualizer/*"],
            "code/components/*": ["src/code/components/*"],
            "code/theme/*": ["src/code/theme/*"],
            "code/utils/*": ["src/code/utils/*"],
            "data/*": ["src/data/*"],
            "worldState": ["src/worldState.ts"]
        }
    },
    "include": ["src", "types", "shared", "ui", "core", "data"],
    "exclude": ["node_modules", "dist", "vite.config.ts"]
}
