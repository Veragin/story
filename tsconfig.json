{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            /* Workspace packages — source-only, mapped straight at the .ts entry (§7).
               All five are real packages as of Phase 6. `@story/types` / `@story/data` are the
               example story (`stories/example/`, multiple stories phase 2): this one program
               can bind each name only once, so it checks the engine against the example. Every
               story, the example included, is also checked on its own through its
               `stories/<id>/tsconfig.json` (`scripts/typecheck-stories.mjs`). */
            "@story/types": ["stories/example/types/index.ts"],
            "@story/shared": ["shared/src/index.ts"],
            "@story/ui": ["ui/src/index.ts"],
            "@story/core": ["core/src/index.ts"],
            "@story/data": ["stories/example/data/index.ts"],
            "@story/data/*": ["stories/example/data/*"],
            "@story/visualizer-protocol": ["Visualizer/protocol/src/index.ts"]

            /* No legacy `baseUrl: src` aliases are left: `src/` is gone as of Phase 8 and
               every app resolves its own files relatively, inside its own workspace.
               Gone as of Phase 4: the components and theme aliases — now `@story/ui`.
               Gone as of Phase 5: the whole utils alias (createWorldState, loadWorldState,
               parsePassageId → `@story/core`) and the engine `ts/` subtree.
               Gone as of Phase 6: `data/*` — the story is `@story/data` (barrel) plus
               `@story/data/*` (the author's tree, a legal deep-import surface per §5).
               Gone as of Phase 7: `code/Engine/*` and `worldState`.
               Gone as of Phase 8: the Visualizer alias, and with it `vite-tsconfig-paths`. */
        }
    },
    /* One program over the whole graph (§7): every workspace, nothing un-migrated left.
       `paths` above is what makes the `@story/*` edges resolve to source rather than to a
       build output, so this must keep listing every package as it is extracted. */
    "include": [
        "stories/example/types",
        "shared",
        "ui",
        "core",
        "stories/example/data",
        "SingleEngine/src",
        "Visualizer/client/src",
        "Visualizer/landing-page/src",
        "MultiEngine/client/src",

        /* The MultiEngine server is node-land, and this program carries the browser libs from
           `tsconfig.base.json`. It is listed here anyway, because §7's rule is one root
           `tsc --noEmit` over the whole graph and an unchecked workspace is worse than an
           over-permissive one. `MultiEngine/server/tsconfig.json` is the stricter, DOM-less
           view of the same files for editors and eslint. */
        "MultiEngine/server/src",

        /* The Visualizer's wire contract and its node server (plan WP1). Same trade-off as the
           MultiEngine server above: node-land checked under the browser libs here, and strictly
           (no DOM, node types) by `Visualizer/server/tsconfig.json`. The server's tests are
           package source like `core/__tests__`, so they are listed too. */
        "Visualizer/protocol/src",
        "Visualizer/protocol/__tests__",
        "Visualizer/server/src",
        "Visualizer/server/__tests__"
    ],
    "exclude": [
        "node_modules",
        "dist",

        /* Node-land config, checked by `tsconfig.node.json` instead — see the note there. */
        "SingleEngine/vite.config.ts",
        "Visualizer/client/vite.config.ts",
        "Visualizer/landing-page/vite.config.ts",
        "MultiEngine/client/vite.config.ts",
        "vitest.workspace.ts"
    ]
}
